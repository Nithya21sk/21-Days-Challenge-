class Library:
    def __init__(self, books):
        self.books = books

    def __str__(self):
        return f"Library contains {len(self.books)} books"

    def __len__(self):
        return len(self.books)

    def __repr__(self):
        return f"Library({self.books})"

lib = Library(["Python", "AI", "Data Science"])

print(lib)
print(len(lib))
print(repr(lib))
